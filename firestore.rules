rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Zeta Idle — Firestore security rules
//
// Baseline model: EVERY request must be authenticated (the app uses anonymous
// auth, so this still covers users who never link an account). Private data
// (cloud saves) is owner-only. Competitive/social docs are publicly readable to
// signed-in users but writable only by their owner, except guild docs which are
// collaborative (see the note there).
//
// Deploy:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Leaderboard write validation — caps values/lengths and enforces types so
    // malformed or absurd entries can't be written. Lenient (per-field guards)
    // so it never rejects a legit, merge, or legacy write. NOTE: this does not
    // make scores un-spoofable (a client can still submit a plausible high
    // score); true anti-cheat needs Cloud Functions.
    function validLeaderboard() {
      let d = request.resource.data;
      return (!('name' in d)      || (d.name is string && d.name.size() <= 24))
          && (!('heroClass' in d) || (d.heroClass is string && d.heroClass.size() <= 40))
          && (!('subclass' in d)  || d.subclass == null || d.subclass is string)
          && (!('score' in d)     || (d.score is int && d.score >= 0 && d.score < 100000000000))
          && (!('stage' in d)     || (d.stage is int && d.stage >= 0))
          && (!('rebirths' in d)  || (d.rebirths is int && d.rebirths >= 0 && d.rebirths < 1000000))
          && (!('floor' in d)     || (d.floor is int && d.floor >= 0))
          && (!('spriteId' in d)    || d.spriteId == null || (d.spriteId is string && d.spriteId.size() <= 40))
          && (!('title' in d)       || d.title == null || (d.title is string && d.title.size() <= 32))
          && (!('nameColorId' in d) || d.nameColorId == null || (d.nameColorId is string && d.nameColorId.size() <= 40))
          && (!('frameId' in d)     || d.frameId == null || (d.frameId is string && d.frameId.size() <= 40))
          && (!('level' in d)       || (d.level is int && d.level >= 0 && d.level < 1000000))
          && (!('ascensionAp' in d) || (d.ascensionAp is int && d.ascensionAp >= 0 && d.ascensionAp < 100000000));
    }

    // ── Private per-user cloud saves ────────────────────────────────────────
    // Only the owner may read or write their save (doc id == uid).
    match /zeta_idle_saves/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── PvP snapshots ───────────────────────────────────────────────────────
    // Signed-in users may read the pool (leaderboard + opponent search);
    // a user may only create/update their OWN snapshot (doc id == uid).
    match /pvp_players/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid);
    }

    // ── Endless / Tower leaderboard ─────────────────────────────────────────
    // Public read to signed-in users; owner-only write (doc id == uid).
    match /endless_leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid) && validLeaderboard();
    }
    match /campaign_leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid) && validLeaderboard();
    }
    match /dungeon_leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid) && validLeaderboard();
    }
    match /boss_rush_leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid) && validLeaderboard();
    }
    match /gauntlet_leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid) && validLeaderboard();
    }

    // ── Guilds (collaborative) ──────────────────────────────────────────────
    // Any signed-in user can read (browse/search) and write (join, chat,
    // raids, territories). Guild ids are random, membership is enforced in the
    // app. NOTE: rules do not verify guild membership here — a determined
    // client could write to an arbitrary guild doc. For launch this is an
    // acceptable baseline; harden later with membership checks or move guild
    // mutations behind Cloud Functions.
    match /guilds/{guildId} {
      allow read, write: if signedIn();

      match /raids/{raidId} {
        allow read, write: if signedIn();
      }
    }

    // ── Guild wars (collaborative) ──────────────────────────────────────────
    match /guild_wars/{warId} {
      allow read, write: if signedIn();
    }

    // ── Default deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
